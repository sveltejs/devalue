{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"declaration": true,
		"declarationDir": "types",
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"diagnostics": true,
		"noEmitOnError": true,
		"lib": ["es6", "esnext", "dom"],
		"module": "esnext",
		"target": "esnext",
		"types": ["node"],
		"rootDir": "./src"
	},
	"include": ["src/index.js", "src/types.ts"],
	"exclude": ["node_modules", "src/*.test.js"]
}
